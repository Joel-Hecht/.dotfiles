#!/bin/bash

if [ $# -ne 1 ]; then
	echo "usage: v <0-100>|up|down" 1>&2
	exit 1
elif ! [[ $1 =~ ^[0-9]+$ ]]; then
	if ! [[ $1 == "up" || $1 == "down" ]]; then
		echo "volume must be a number 0-100, up, or down" 1>&2
		exit 1
	fi
elif [[ $1 -gt 100 || $1 -lt 0 ]]; then
	echo "volume number must be between 0 and 100" 1>&2
	exit 1
fi

VOLUME=~/.VOLUME
current="$( cat $VOLUME )"

# make sure another run of volume isn't currently in progress
if [[ "$current" == "IN PROGRESS" ]]; then
	echo "you're going too fast"
	exit 2
fi

# tell volume we're currently running it
chmod 644 $VOLUME
echo IN PROGRESS > $VOLUME

# set new volume
if [[ "$1" == "down" ]]; then
	[[ $current -gt 5 ]] && new=$(( current - 5)) || new=0
elif [[ "$1" == "up" ]]; then
	[[ $current -lt 95 ]] && new=$((current + 5)) || new=100
else
	new=$1
fi

amixer -q -M set Master $new% &>/dev/null

# reload i3bar
sed -i "s/= \".*W:/= \"VOLUME: ${new#0}% :|: W:/" ~/.i3status.conf
killall i3bar &>/dev/null
i3bar --bar_id=bar-0 & &>/dev/null # this & is very necessary for some reason

# set volume file
echo $new > $VOLUME
# weird with permissions because i don't want this file getting messed up
chmod 444 $VOLUME
