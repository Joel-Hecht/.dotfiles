#!/bin/bash

LSCOLOUR='\033[0;32m'
NC='\033[0m'

while [ 1 -gt 0 ]; do
	echo
	sleep 1
	numdests=$( ls -d */ 2> /dev/null | wc -l ) || 0
	if [ $( shuf -i 1-2 -n 1  ) -gt 1 ] || [ $numdests -lt 1 ]; then
		cd ..
	else
		cd $( ls -d */ | head -n $( shuf -i 1-$numdests -n 1 ) | tail -n 1 )
	fi
	printf "${LSCOLOUR}$( pwd | sed "s|$HOME|~|" )${NC}\n"
	ls --color=auto
done
