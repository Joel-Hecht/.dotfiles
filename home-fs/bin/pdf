#!/bin/bash

if [ -z "$1" ]; then
	echo "needs an argument (pdf file)" >&2
	exit 1
else
	file=$(realpath "$1")
fi

prove_ext=$(grep -e '\.pdf$' "$file")

if [[ -z "$prove_ext" ]]; then
	if  [[ -e "$file" ]]; then
		$(browser --new-tab "$file")
	else
		echo "file $file does not exist" >&2
	fi	

else
	echo "not a pdf file or doesnt exist" >&2
fi

