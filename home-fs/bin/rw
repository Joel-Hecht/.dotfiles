#!/bin/bash

LSCOLOUR='\033[0;32m'
NC='\033[0m'

while [ 1 -gt 0 ]; do
	echo
	sleep 0.5
	numdests=$( ls -d */ 2> /dev/null | wc -l ) || 0
	if [[ ( $( shuf -i 1-2 -n 1  ) -gt 1  || $numdests -lt 1 || $( pwd ) == "/bin"* || $( pwd ) == "/usr/bin"* ) && $( pwd ) != ~ ]]; then
		# don't want to go down infinite /bin/X11s & don't want to try to go back from /
		cd ..
	else
		target="lost+found/" # slightly inelegant way to prevent it from trying to go places it can't
		while [[ "$target" == "lost+found/" || "$target" == "root/" ]]; do
			target=$( ls -d */ 2> /dev/null | head -n $( shuf -i 1-$numdests -n 1 ) | tail -n 1 )
		done
		cd "$target" 2>/dev/null || cd ..
	fi
	printf "${LSCOLOUR}$( pwd | sed "s|$HOME|~|" )${NC}\n"
	ls --color=auto 2>/dev/null
done
