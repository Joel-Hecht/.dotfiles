#!/bin/bash

popeid=""

sleeptime=1.5

float_regex="^[0-9]*\.?[0-9]*$"

#overkill handler but I want to be conventional
while getopts ':lfpt:' flag; do
	case "${flag}" in 
		f) popeid="266" ;; #Francis I, the 266th pope
		l) popeid="267" ;; #Leo XIV, the 267th pope
		p) popeid="260" ;; #Pius XII, the 260th pope
		t) sleeptime=${OPTARG}
			if ! [[ "$sleeptime" =~ $float_regex ]]; then
				echo "invalid time entered - please use a float!"
				exit 1
			fi
			;;
		:) echo "Error: option -${OPTARG} requires an argument" >&2
			exit 1
			;;
		\?) echo "Error: invalid operation -${OPTARG}" >&2
			exit 1
			;;
	esac
done

popeaddress="${HOME}/img/pope${popeid}.jpg"

feh -Z "$popeaddress" &

pid=$!

# From https://unix.stackexchange.com/questions/450700/opening-a-programme-in-a-floating-window-in-i3
# Wait for the window to open and grab its window ID
winid=''
while : ; do
    winid="`wmctrl -lp | awk -vpid=$pid '$3==pid {print $1; exit}'`"
    [[ -z "${winid}" ]] || break
done

#focus on pope 
wmctrl -ia "${winid}"

i3-msg floating enable > /dev/null;
i3-msg move position center > /dev/null;

sleep $sleeptime

kill -9 $pid
