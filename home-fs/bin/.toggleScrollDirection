#!/bin/bash

prop="libinput Natural Scrolling Enabled"
for id in $( xinput list --id-only ); do
	cur=$( xinput list-props "$id" | grep -F "$prop (" | awk '{ print $NF }' )
	[ -n "$cur" ] || continue
	xinput set-prop "$id" "$prop" $(( 1 - cur ))
done

#xmodmap -e "remove shift = Escape"
#xmodmap -e "keycode 108 = Multi_key Alt_R"
