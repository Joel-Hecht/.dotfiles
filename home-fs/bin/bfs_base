#!/bin/bash

function helpmsg {
	echo "bfs: breadth first recursive cd"
	echo "syntax: bfs [OPTION] dirname [maxdepth (default=5)]"
	echo "options:"
	echo "\t-h: explore hidden directories (also bfsh)"
	echo "\t-r: start from root (also bfsr)"
	echo "\t-f: explore fully and go to last used match"
	echo "\t-t: (tab) find directory starting with argument"
	echo "\t-i: infinite depth"
	echo "\t-s: (stars) find directory containing argument anywhere"
}

# help
if [[ $# -eq 0 || $1 == "--help" ]]; then
	helpmsg
	return 0
fi

# options
OPTIND=1
hidden=""
root=""
full=""
tab=""
infinite=""
stars=""
while getopts "hrftis" opt; do
	case $opt in
		h) hidden=yes ;;
		r) root=yes ;;
		f) full=yes ;;
		t) tab=yes ;;
		i) infinite=yes ;;
		s) stars=yes ;;
		\?) echo "Invalid option -$OPTARG" >&2
			return 1 ;;
	esac
done
shift $(( OPTIND - 1 ))
if [[ $# -eq 0 ]]; then
	helpmsg
	return 0
fi

[[ $hidden ]] || prune=( -type d -path '*/.*' -prune -o )
[[ $root ]] && path="$HOME" || path='.'

[[ $# -gt 1 ]] && maxdepth="$2" || maxdepth=9
[[ "$maxdepth" =~ ^[0-9]+$ ]] || { echo "maxdepth must be a number" >&2 ;
									return 1; }
[[ $infinite ]] && maxdepth=999

arg="$1"
[[ $stars ]] && arg="*$arg*"
[[ $tab ]] && arg="$arg*"

targets="$( /usr/bin/bfs $path "${prune[@]}" \
			-type d -name "$arg" -printf "%T@ %p\n" )"

[[ $full ]] && targets="$( echo "$targets" | sort -nr )"

dest="$( echo "$targets" | head -n 1 | awk '{ for (i = 2; i < NF; i++) \
											printf "%s ", $i; print $NF }' )"
[[ $dest ]] && cd "$dest" || { echo "Destination not found!" >&2; return 1; }
return 0
