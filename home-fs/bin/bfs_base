#!/bin/bash

function helpmsg {
	echo "bfs: breadth first find wrapper"
	echo ""
	echo "syntax: bfs {OPTIONS} dirname"
	echo "syntax: bfs {OPTIONS} cmd *args"
	echo "if only one arg, bfs will find a directory and cd there"
	echo "otherwise, bfs will find any filetype and run \$1 on it "
	echo "use _ before an argument to leave it exact (e.g. bfs mv old _new )"
	echo ""
	echo "options:"
	echo "	-h: explore hidden directories"
	echo "	-r: start from ~ instead of pwd"
	echo "	-f: explore fully and pick last used match"
	echo "	-t: match anything starting with argument"
	echo "	-i: infinite depth"
	echo "	-s: match anything containing argument"
	echo "	-d: match only directories"
	echo "  -l: match locations of files rather than files"
}

if [[ $# -eq 0 || $1 == "--help" ]]; then
	helpmsg
	return 0
fi

# options
OPTIND=1
hidden="" root="" full="" tab="" infinite="" stars="" dir="" loc=""
while getopts "hrftisdl" opt; do
	case $opt in
		h) hidden=yes ;;
		r) root=yes ;;
		f) full=yes ;;
		t) tab=yes ;;
		i) infinite=yes ;;
		s) stars=yes ;;
		d) dir=yes ;;
		l) loc=yes ;;
		\?) echo "Invalid option -$OPTARG" >&2
			return 1 ;;
	esac
done
shift $(( OPTIND - 1 ))

if [[ $# -eq 0 ]]; then
	helpmsg
	return 0
elif [[ $# -eq 1 ]]; then
	args=("cd")
	[[ $loc ]] && type=() || type=( -type d )
else
	type=()
	if [[ -n $( 'type' -t "$1" ) ]]; then
		args=("$1")
		shift
	else
		args=()
	fi
fi

if [[ $hidden ]]; then
	prune=()
	maxdepth=7
else
	prune=( -type d -path '*/.*' -prune -o )
	maxdepth=9
fi
[[ $root ]] && path="$HOME" || path='.'
[[ $infinite ]] && maxdepth=999
[[ $dir ]] && type=( -type d )

for arg in "$@"; do
	if [[ "$arg" == __* ]]; then
		arg=${arg#_}
	elif [[ "$arg" == _* ]]; then
		args+=("${arg#_}")
		continue
	fi

	[[ $stars ]] && arg="*$arg*"
	[[ $tab ]] && arg="$arg*"

	targets="$( /usr/bin/bfs $path -maxdepth $maxdepth "${prune[@]}" "${type[@]}" -path "*/$arg" -name "$(basename $arg)" -printf "%T@ %p\n" )"
	[[ $full ]] && targets="$( echo "$targets" | sort -nr )"
	line="$( echo "$targets" | head -n 1 )"
	found="${line#* }" # remove first word
	[[ $found ]] || { echo "$arg not found!" ; return 1; }
	[[ $loc ]] && found=("$( dirname "$found" )")
	args+=("$found")
done

"${args[@]}"
