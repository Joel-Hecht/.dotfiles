bindsym Control+$alt+h       exec --no-startup-id bash ${HOME}/bin/.toggleScrollDirection

# fix broken right shift
bindsym Control+Shift+$alt+h exec --no-startup-id bash $( xmodmap -e "keycode 62 = Escape NoSymbol" && xmodmap -e "remove shift = Escape" )

# audio buttons
bindsym F1 exec --no-startup-id bash ${HOME}/bin/.mute_unmute
bindsym F2 exec --no-startup-id bash ${HOME}/bin/.volume down
bindsym F3 exec --no-startup-id bash ${HOME}/bin/.volume up
bindsym F4 exec --no-startup-id bash ${HOME}/bin/.fix_volume
exec_always --no-startup-id touch "${HOME}/.VOLUME"

bindsym F10 exec --no-startup-id bash ${HOME}/bin/brightness -r
bindsym F11 exec --no-startup-id bash ${HOME}/bin/brightness -c "-0.1"
bindsym F12 exec --no-startup-id bash ${HOME}/bin/brightness -c "0.1"

#activate gnome policykit, needed for i3wm to authenmtiate root
exec_always --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &

#screen no longer shuts down after inactivity.  Useful for watching movies with Karen Wongso
exec --no-startup-id xset s off
exec --no-startup-id xset -dpms
exec --no-startup-id xset s noblank
