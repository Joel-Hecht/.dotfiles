bindsym Control+$alt+p exec --no-startup-id flatpak run com.github.PintaProject.Pinta &
bindsym Control+$alt+k exec --no-startup-id kitty calcurse

#website shortcuts
bindsym Control+$alt+d       exec --no-startup-id firefox discord.com/channels/@me
bindsym Control+Shift+$alt+d exec --no-startup-id chromium virginiatech-my.sharepoint.com/my
