bindsym Control+Shift+$alt+a exec --no-startup-id firefox drive.google.com/drive/u/0/my-drive
bindsym Control+$alt+y       exec --no-startup-id firefox youtube.com/feed/subscriptions
bindsym Control+Shift+$alt+c exec --no-startup-id firefox canvas.vt.edu
